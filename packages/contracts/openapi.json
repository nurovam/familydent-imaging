{
  "components": {
    "schemas": {
      "AccountResponse": {
        "properties": {
          "csrf_token": {
            "title": "Csrf Token",
            "type": "string"
          },
          "display_name": {
            "title": "Display Name",
            "type": "string"
          },
          "id": {
            "format": "uuid",
            "title": "Id",
            "type": "string"
          },
          "role": {
            "enum": [
              "doctor",
              "imaging_staff",
              "platform_admin"
            ],
            "title": "Role",
            "type": "string"
          }
        },
        "required": [
          "id",
          "display_name",
          "role",
          "csrf_token"
        ],
        "title": "AccountResponse",
        "type": "object"
      },
      "AssignmentInput": {
        "additionalProperties": false,
        "properties": {
          "clinic_id": {
            "format": "uuid",
            "title": "Clinic Id",
            "type": "string"
          },
          "doctor_id": {
            "format": "uuid",
            "title": "Doctor Id",
            "type": "string"
          }
        },
        "required": [
          "doctor_id",
          "clinic_id"
        ],
        "title": "AssignmentInput",
        "type": "object"
      },
      "ClinicInput": {
        "additionalProperties": false,
        "properties": {
          "name": {
            "maxLength": 160,
            "minLength": 1,
            "title": "Name",
            "type": "string"
          }
        },
        "required": [
          "name"
        ],
        "title": "ClinicInput",
        "type": "object"
      },
      "CodeInput": {
        "additionalProperties": false,
        "properties": {
          "code": {
            "pattern": "^[0-9]{6}$",
            "title": "Code",
            "type": "string"
          }
        },
        "required": [
          "code"
        ],
        "title": "CodeInput",
        "type": "object"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "PasswordInput": {
        "additionalProperties": false,
        "properties": {
          "email": {
            "maxLength": 254,
            "minLength": 3,
            "title": "Email",
            "type": "string"
          },
          "password": {
            "format": "password",
            "maxLength": 128,
            "minLength": 1,
            "title": "Password",
            "type": "string",
            "writeOnly": true
          }
        },
        "required": [
          "email",
          "password"
        ],
        "title": "PasswordInput",
        "type": "object"
      },
      "PatientInput": {
        "additionalProperties": false,
        "properties": {
          "display_name": {
            "maxLength": 160,
            "minLength": 1,
            "title": "Display Name",
            "type": "string"
          },
          "local_identifier": {
            "maxLength": 80,
            "minLength": 1,
            "title": "Local Identifier",
            "type": "string"
          }
        },
        "required": [
          "local_identifier",
          "display_name"
        ],
        "title": "PatientInput",
        "type": "object"
      },
      "StudyInput": {
        "additionalProperties": false,
        "properties": {
          "modality": {
            "enum": [
              "CBCT",
              "OPG",
              "IO",
              "CT",
              "DX",
              "CR"
            ],
            "title": "Modality",
            "type": "string"
          },
          "patient_id": {
            "format": "uuid",
            "title": "Patient Id",
            "type": "string"
          },
          "title": {
            "maxLength": 200,
            "minLength": 1,
            "title": "Title",
            "type": "string"
          }
        },
        "required": [
          "patient_id",
          "title",
          "modality"
        ],
        "title": "StudyInput",
        "type": "object"
      },
      "StudyPage": {
        "properties": {
          "items": {
            "items": {
              "$ref": "#/components/schemas/StudySummary"
            },
            "title": "Items",
            "type": "array"
          },
          "limit": {
            "title": "Limit",
            "type": "integer"
          },
          "offset": {
            "title": "Offset",
            "type": "integer"
          },
          "total": {
            "title": "Total",
            "type": "integer"
          }
        },
        "required": [
          "items",
          "total",
          "limit",
          "offset"
        ],
        "title": "StudyPage",
        "type": "object"
      },
      "StudySummary": {
        "properties": {
          "created_at": {
            "title": "Created At",
            "type": "string"
          },
          "display_name": {
            "title": "Display Name",
            "type": "string"
          },
          "id": {
            "format": "uuid",
            "title": "Id",
            "type": "string"
          },
          "local_identifier": {
            "title": "Local Identifier",
            "type": "string"
          },
          "modality": {
            "title": "Modality",
            "type": "string"
          },
          "patient_id": {
            "format": "uuid",
            "title": "Patient Id",
            "type": "string"
          },
          "state": {
            "enum": [
              "REGISTERED",
              "READY",
              "BLOCKED"
            ],
            "title": "State",
            "type": "string"
          },
          "title": {
            "title": "Title",
            "type": "string"
          }
        },
        "required": [
          "id",
          "patient_id",
          "local_identifier",
          "display_name",
          "title",
          "modality",
          "state",
          "created_at"
        ],
        "title": "StudySummary",
        "type": "object"
      },
      "UserInput": {
        "additionalProperties": false,
        "properties": {
          "clinic_id": {
            "anyOf": [
              {
                "format": "uuid",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Clinic Id"
          },
          "display_name": {
            "maxLength": 160,
            "minLength": 1,
            "title": "Display Name",
            "type": "string"
          },
          "email": {
            "maxLength": 254,
            "minLength": 3,
            "title": "Email",
            "type": "string"
          },
          "password": {
            "format": "password",
            "maxLength": 128,
            "minLength": 12,
            "title": "Password",
            "type": "string",
            "writeOnly": true
          },
          "role": {
            "enum": [
              "doctor",
              "imaging_staff"
            ],
            "title": "Role",
            "type": "string"
          }
        },
        "required": [
          "email",
          "display_name",
          "role",
          "password"
        ],
        "title": "UserInput",
        "type": "object"
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      }
    }
  },
